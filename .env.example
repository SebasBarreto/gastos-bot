# Renombra este archivo a  .env  y llena los valores.

# 1) Token del bot de Telegram (te lo da @BotFather al crear el bot)
TELEGRAM_TOKEN=123456:ABC-DEF...

# 2) Token de integracion de Notion (Internal Integration Secret)
#    https://www.notion.so/my-integrations  ->  New integration  ->  copia el "secret".
NOTION_TOKEN=secret_...

# 3) ID de la base "Movimientos" (ya lo dejamos puesto)
NOTION_DB_ID=cf610e54-fd9e-428c-bc68-8b620fcba260

# 4) (Opcional pero recomendado) Tu chat id, para que el bot SOLO te responda a ti.
#    Escribele /start al bot y mira el id, o dejalo vacio al principio.
ALLOWED_CHAT_ID=
